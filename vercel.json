{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1600,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "excludeFiles": ".cache/puppeteer/**"
    }
  }
}
